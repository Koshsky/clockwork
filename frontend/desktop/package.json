{
  "name": "mvs-erp-desktop",
  "description": "\u041d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u0430\u044f \u043e\u0431\u0432\u044f\u0437\u043a\u0430 MVS ERP (Electron) \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e vite-\u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0430",
  "main": "main.js",
  "author": {
    "name": "MVS ERP",
    "email": "shmonov.mv@gmail.com"
  },
  "homepage": "https://service.mvsservice.ru",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:web": "npm run build",
    "start": "electron .",
    "dist": "node build.cjs",
    "dist:win": "node build.cjs --win",
    "dist:mac": "node build.cjs --mac",
    "dist:linux": "node build.cjs --linux"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.mvs.erp",
    "productName": "MVS ERP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "storage.cjs",
      "storage-worker.cjs",
      "storage-db.cjs",
      "storage-schema.cjs",
      "storage-validation.cjs",
      "session-vault.cjs",
      "session-service.cjs",
      "session-ipc.cjs",
      "api-routes.json",
      "application.cjs",
      "renderer-recovery.cjs",
      "profile.cjs",
      "protocol.cjs",
      "protocol-operations.json",
      "service.cjs",
      "ipc.cjs",
      "preload.js",
      "security.cjs",
      "static-server.cjs",
      "package.json",
      "command-request.cjs",
      "command-queue.cjs",
      "sync-service.cjs",
      "command-cacheProjection.cjs",
      "command-planning.cjs",
      "command-timesheet.cjs",
      "command-revisions.cjs",
      "command-baseline.cjs",
      "command-periodAvailability.cjs",
      "command-calendar.cjs",
      "command-date.cjs",
      "command-clamp.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Office;Business"
    },
    "asarUnpack": [
      "storage*.cjs",
      "protocol.cjs",
      "protocol-operations.json",
      "session-service.cjs",
      "api-routes.json",
      "command-request.cjs",
      "command-queue.cjs",
      "sync-service.cjs",
      "command-cacheProjection.cjs",
      "command-planning.cjs",
      "command-timesheet.cjs",
      "command-revisions.cjs",
      "command-baseline.cjs",
      "command-periodAvailability.cjs",
      "command-calendar.cjs",
      "command-date.cjs",
      "command-clamp.cjs"
    ]
  }
}
