# Development values only. Replace placeholders; never commit .env.
COMPOSE_PROJECT_NAME=erp-dev
DATABASE_NAME=erp
DATABASE_USER=erp
DATABASE_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgres://erp:replace-with-local-database-password@localhost:5432/erp?sslmode=disable
ADMIN_PASSWORD=replace-with-local-admin-password
JWT_SECRET_KEY=replace-with-a-random-key-of-at-least-32-characters
# Retained for compatibility with older administrative tooling.
JWT_REFRESH_KEY=replace-with-another-random-key-at-least-32-characters
TRACING_ENDPOINT=localhost:4317
REDIS_ADDRESS=localhost:6379
AUDIT_URL=http://localhost:3100
VITE_API_URL=/api/v1
